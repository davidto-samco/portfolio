---
---

<section
  id="home"
  class="scroll-mt-16 border-b border-zinc-800/80 px-6 py-24 sm:py-32"
>
  <div class="mx-auto max-w-4xl">
    <div class="mb-8 flex items-center gap-2 text-xs text-zinc-500">
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-red-500/80"></span>
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-yellow-500/80"></span>
      <span class="inline-block h-2.5 w-2.5 rounded-full bg-green-500/80"></span>
      <span class="ml-3">~/portfolio — zsh — 80×24</span>
    </div>

    <div class="space-y-2">
      <div class="text-base text-zinc-400 sm:text-lg">
        <span class="text-emerald-400">$</span>
        <span class="ml-2">whoami</span>
      </div>
      <h1
        class="text-4xl font-bold tracking-tight text-zinc-50 sm:text-6xl"
      >
        Andrei D.
      </h1>
    </div>

    <div class="mt-10 space-y-2">
      <div class="text-base text-zinc-400 sm:text-lg">
        <span class="text-emerald-400">$</span>
        <span class="ml-2">cat ~/title.txt</span>
      </div>
      <p class="text-xl text-cyan-400 sm:text-2xl">
        DevOps Engineer &amp; Course Creator
      </p>
    </div>

    <div class="mt-10 flex items-center text-base sm:text-lg">
      <span class="text-emerald-400">$</span>
      <span
        class="ml-3 inline-block h-5 w-2.5 animate-blink bg-cyan-400 align-middle"
      ></span>
    </div>
  </div>
</section>
