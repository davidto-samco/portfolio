---
import SectionHeading from './SectionHeading.astro';

const skills = [
  'Linux',
  'Docker',
  'nginx',
  'BIND DNS',
  'Python',
  'Bash',
  'Claude Code',
  'n8n',
  'Kubernetes',
  'CI/CD',
  'Git',
];
---

<section
  id="skills"
  class="scroll-mt-16 border-b border-zinc-800/80 px-6 py-20"
>
  <div class="mx-auto max-w-4xl">
    <SectionHeading command="ls ~/skills/" />
    <ul class="flex flex-wrap gap-2">
      {
        skills.map((s) => (
          <li class="rounded border border-zinc-800 bg-zinc-900/50 px-3 py-1.5 text-sm text-zinc-300 transition-colors hover:border-cyan-400/50 hover:text-cyan-300">
            {s}
          </li>
        ))
      }
    </ul>
  </div>
</section>
