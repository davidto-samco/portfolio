---
import SectionHeading from './SectionHeading.astro';
---

<section
  id="about"
  class="scroll-mt-16 border-b border-zinc-800/80 px-6 py-20"
>
  <div class="mx-auto max-w-4xl">
    <SectionHeading command="cat ~/about.md" />
    <div class="border-l-2 border-cyan-400/40 pl-6">
      <p class="font-sans text-base leading-relaxed text-zinc-300 sm:text-lg">
        I build and automate infrastructure, and I teach DevOps and AI tooling
        to engineers. I create courses focused on practical skills that apply
        on day one of a real job.
      </p>
    </div>
  </div>
</section>
