---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Andrei D. — DevOps Engineer & Course Creator',
  description = 'DevOps Engineer and course creator. I build and automate infrastructure, and I teach DevOps and AI tooling to engineers.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-zinc-950 font-mono text-zinc-200 antialiased selection:bg-cyan-400/20 selection:text-cyan-200"
  >
    <slot />
  </body>
</html>
